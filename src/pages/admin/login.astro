---
export const prerender = false;
import { isAdmin } from '../../lib/auth.js';
if (isAdmin(Astro.request)) return Astro.redirect('/admin/');
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>Admin Login — Essence by Aditi</title>
  <style>
    * { margin: 0; box-sizing: border-box; }
    body { font-family: system-ui, sans-serif; min-height: 100vh; display: flex; align-items: center; justify-content: center; background: #f8fafc; }
    .card { background: white; border-radius: 1.5rem; padding: 3rem; box-shadow: 0 4px 24px rgba(0,0,0,0.08); width: 100%; max-width: 380px; }
    h1 { font-size: 1.5rem; font-weight: 600; color: #1E3A8A; margin-bottom: 0.5rem; }
    p { font-size: 0.875rem; color: #64748b; margin-bottom: 1.5rem; }
    input { width: 100%; padding: 0.75rem 1rem; border: 1px solid #e2e8f0; border-radius: 0.75rem; font-size: 0.875rem; outline: none; }
    input:focus { border-color: #DB2777; box-shadow: 0 0 0 3px rgba(219,39,119,0.1); }
    button { width: 100%; padding: 0.75rem; border: none; border-radius: 0.75rem; background: #1E3A8A; color: white; font-size: 0.875rem; font-weight: 600; cursor: pointer; margin-top: 1rem; }
    button:hover { background: #2563EB; }
    .err { color: #ef4444; font-size: 0.75rem; margin-top: 0.5rem; display: none; }
  </style>
</head>
<body>
  <div class="card">
    <h1>Essence Admin</h1>
    <p>Enter admin password to continue.</p>
    <form id="f">
      <input type="password" id="pw" placeholder="Password" required autofocus />
      <p class="err" id="err">Wrong password</p>
      <button type="submit">Sign in</button>
    </form>
  </div>
  <script>
    document.getElementById('f').addEventListener('submit', async (e) => {
      e.preventDefault();
      const pw = document.getElementById('pw').value;
      const res = await fetch('/api/auth', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password: pw }),
      });
      if (res.ok) {
        window.location.href = '/admin/';
      } else {
        document.getElementById('err').style.display = 'block';
      }
    });
  </script>
</body>
</html>
