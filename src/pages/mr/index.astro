---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import WhatsApp from '../../components/WhatsApp.astro';
import Marquee from '../../components/Marquee.jsx';
import NewsletterForm from '../../components/NewsletterForm.jsx';
import { Reveal } from '../../components/Motion.jsx';
import { SERVICES, MANIFESTO, TESTIMONIALS, PARTNERS } from '../../data/content.js';
import { getT, localizeServices, localizeManifesto } from '../../i18n.js';

const T = getT('mr');
const mrServices = localizeServices(SERVICES, 'mr');
const mrManifesto = localizeManifesto(MANIFESTO, 'mr');

const FORMSPREE_ID = import.meta.env.PUBLIC_FORMSPREE_ID || 'YOUR_FORM_ID';
const heroQuote = T.hero.quote.replace(/"/g, '');
---

<Base title="एसन्स बाय अदिती — डॉ. अदिती वरेकर खताते | आयुर्वेदिक डॉक्टर नवी मुंबई" description="डॉ. अदिती वरेकर खताते (BAMS, MD आयुर्वेद), नवी मुंबई — केस, त्वचा, नखं व स्त्री-आरोग्यासाठी मुळापासून आयुर्वेदिक काळजी. भेट बुक करा." lang="mr">
  <Navbar />

  <!-- Hero — Marathi inline (no React HeroSection island needed) -->
  <section class="relative min-h-[92vh] flex flex-col justify-center pt-28 pb-20 overflow-hidden">
    <div class="fluid-bg pointer-events-none"></div>
    <div class="relative max-w-7xl mx-auto px-6 lg:px-10 w-full">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-0 items-center">
        <div class="lg:col-span-7 lg:pr-8">
          <div class="inline-flex items-center gap-2 rounded-full border border-brand-blue/20 bg-brand-blue/5 px-4 py-1.5 text-xs font-semibold text-brand-blue tracking-wide mb-8">
            {T.hero.badge}
          </div>
          <h1 class="font-serif text-4xl sm:text-5xl lg:text-[3.6rem] xl:text-[4rem] leading-[1.07] tracking-tight text-brand-dark">
            <span class="block">{T.hero.l1}</span>
            <span class="block">{T.hero.l2}</span>
            <span class="block text-magic italic">{T.hero.l3}</span>
          </h1>
          <p class="mt-7 text-slate-600 leading-relaxed max-w-xl text-base lg:text-lg">
            <span>{T.hero.sub1}</span><strong class="text-brand-dark">{T.hero.subBold}</strong><span>{T.hero.sub2}</span>
          </p>
          <div class="mt-9 flex flex-wrap gap-4">
            <a href="/mr/contact/" class="sheen inline-flex items-center gap-2 rounded-full bg-brand-navy text-white px-7 py-3.5 text-sm font-semibold transition-all duration-300 hover:bg-gradient-to-r hover:from-brand-blue hover:to-brand-pink hover:-translate-y-0.5 hover:shadow-xl hover:shadow-pink-900/20">
              {T.hero.cta1} →
            </a>
            <a href="/mr/services/" class="inline-flex items-center gap-2 rounded-full border-2 border-brand-navy/20 text-brand-navy px-7 py-3.5 text-sm font-semibold transition-all duration-300 hover:border-brand-navy hover:bg-brand-navy/5">
              {T.hero.cta2}
            </a>
          </div>
          <div class="mt-12 flex flex-wrap gap-8">
            {T.hero.stats.map((stat) => (
              <div>
                <p class="font-serif text-3xl text-magic">{stat[0]}</p>
                <p class="text-xs text-slate-500 mt-0.5">{stat[1]}</p>
              </div>
            ))}
          </div>
        </div>
        <div class="lg:col-span-5 relative">
          <Reveal client:visible>
            <div class="relative max-w-sm mx-auto lg:max-w-none">
              <div class="absolute -inset-4 rounded-[2.5rem] bg-gradient-to-br from-indigo-200/50 via-white/0 to-pink-200/50 blur-md" aria-hidden="true"></div>
              <div class="img-frame relative rounded-[2rem] shadow-2xl shadow-blue-900/10 rotate-1">
                <img src="/images/portrait-4.webp" alt="डॉ. अदिती वरेकर खताते" class="w-full aspect-[3/4] object-cover" width="480" height="640" fetchpriority="high" />
              </div>
              <div class="absolute -bottom-5 -left-4 glass rounded-2xl p-4 shadow-lg shadow-blue-900/10 max-w-[200px]">
                <p class="font-serif text-xl text-magic">{heroQuote}</p>
                <p class="text-[10px] text-slate-500 mt-1">{T.hero.quoteBy}</p>
              </div>
            </div>
          </Reveal>
        </div>
      </div>
    </div>
  </section>

  <Marquee client:visible />

  <!-- Elements — Five great elements inline -->
  <section class="relative py-20 lg:py-28 overflow-hidden">
    <div class="fluid-bg"></div>
    <div class="relative max-w-7xl mx-auto px-6 lg:px-10">
      <Reveal client:visible>
        <p class="text-xs uppercase tracking-[0.25em] text-brand-blue font-semibold mb-4">{T.elements.overline}</p>
        <h2 class="font-serif text-3xl md:text-4xl lg:text-5xl tracking-tight text-brand-dark max-w-2xl">
          {T.elements.h1} <span class="text-magic italic">{T.elements.h2}</span>
        </h2>
        <p class="mt-4 text-slate-600 max-w-xl leading-relaxed">{T.elements.sub}</p>
      </Reveal>
      <div class="mt-14 grid sm:grid-cols-3 lg:grid-cols-5 gap-5">
        {T.elements.items.map((el, i) => (
          <Reveal client:visible delay={i * 0.07}>
            <div class="card-lift glass-deep rounded-3xl p-6 text-center group">
              <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-gradient-to-br from-indigo-100 to-pink-100 flex items-center justify-center">
                <span class="font-serif text-lg text-brand-navy">{i + 1}</span>
              </div>
              <h3 class="font-serif text-lg text-brand-dark mb-1">{el.name}</h3>
              <p class="text-xs text-slate-500">{el.sub}</p>
            </div>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <!-- Manifesto -->
  <section class="relative py-20 lg:py-28 overflow-hidden">
    <div class="fluid-bg"></div>
    <div class="relative max-w-7xl mx-auto px-6 lg:px-10">
      <Reveal client:visible>
        <p class="text-xs uppercase tracking-[0.25em] text-brand-blue font-semibold mb-4">{T.manifesto.overline}</p>
        <h2 class="font-serif text-3xl md:text-4xl lg:text-5xl tracking-tight text-brand-dark max-w-2xl leading-tight">
          {T.manifesto.h1}<br /><span class="text-magic italic">{T.manifesto.h2}</span>
        </h2>
      </Reveal>
      <div class="mt-14 grid md:grid-cols-2 gap-x-16 gap-y-14">
        {mrManifesto.map((m, i) => (
          <Reveal client:visible delay={i * 0.08}>
            <div class="flex gap-8 group">
              <span class="font-serif text-6xl lg:text-7xl font-light text-indigo-200 leading-none transition-colors duration-500 group-hover:text-pink-300 select-none">{m.num}</span>
              <div class="pt-2">
                <h3 class="font-serif text-xl md:text-2xl text-brand-navy mb-3">{m.title}</h3>
                <p class="text-sm md:text-base text-slate-600 leading-relaxed max-w-md">{m.text}</p>
              </div>
            </div>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="py-20 lg:py-28 bg-white/50 relative">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <Reveal client:visible className="flex flex-wrap items-end justify-between gap-6 mb-16">
        <div>
          <p class="text-xs uppercase tracking-[0.25em] text-brand-blue font-semibold mb-4">{T.servicesSec.overline}</p>
          <h2 class="font-serif text-3xl md:text-4xl lg:text-5xl tracking-tight text-brand-dark">{T.servicesSec.h1} <span class="text-magic italic">{T.servicesSec.h2}</span></h2>
        </div>
        <a href="/mr/services/" class="link-underline text-sm font-semibold text-brand-navy inline-flex items-center gap-1">{T.servicesSec.all} ↗</a>
      </Reveal>
      <div class="grid md:grid-cols-3 gap-6">
        {mrServices.slice(0, 6).map((s, i) => (
          <Reveal client:visible delay={i * 0.06}>
            <a href="/mr/services/" class:list={['card-lift group block rounded-3xl p-8 border h-full', i === 0 || i === 3 ? 'bg-gradient-to-br from-brand-navy to-[#3B2A8A] border-transparent text-white' : 'glass-deep border-indigo-100']}>
              <span class:list={['font-serif text-4xl font-light', i === 0 || i === 3 ? 'text-pink-300' : 'text-indigo-200 group-hover:text-pink-300 transition-colors duration-500']}>{s.num}</span>
              <h3 class:list={['font-serif text-xl mt-6 mb-3', i === 0 || i === 3 ? 'text-white' : 'text-brand-dark']}>{s.title}</h3>
              <p class:list={['text-sm leading-relaxed', i === 0 || i === 3 ? 'text-indigo-100/80' : 'text-slate-600']}>{s.short}</p>
              <span class:list={['mt-6 inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-widest', i === 0 || i === 3 ? 'text-pink-200' : 'text-brand-pink']}>{T.servicesSec.learn} →</span>
            </a>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <!-- Clinic -->
  <section class="py-20 lg:py-28 relative overflow-hidden">
    <div class="fluid-bg"></div>
    <div class="relative max-w-7xl mx-auto px-6 lg:px-10 grid lg:grid-cols-2 gap-14 items-center">
      <Reveal client:visible>
        <div class="grid grid-cols-2 gap-4">
          <div class="img-frame rounded-3xl mt-8"><img src="/images/clinic-1.webp" alt="डॉ. अदिती रुग्णाशी सल्लामसलत करताना" loading="lazy" class="w-full aspect-[3/4] object-cover" /></div>
          <div class="img-frame rounded-3xl"><img src="/images/clinic-4.webp" alt="ट्रायकोस्कोपी निदान सत्र" loading="lazy" class="w-full aspect-[3/4] object-cover" /></div>
        </div>
      </Reveal>
      <Reveal client:visible delay={0.1}>
        <div>
          <p class="text-xs uppercase tracking-[0.25em] text-brand-blue font-semibold mb-4">{T.clinic.overline}</p>
          <h2 class="font-serif text-3xl md:text-4xl lg:text-5xl tracking-tight text-brand-dark leading-tight mb-6">
            {T.clinic.h1} <span class="text-magic italic">{T.clinic.hI}</span>{T.clinic.h2}
          </h2>
          <p class="text-slate-600 leading-relaxed mb-6">{T.clinic.text}</p>
          <ul class="space-y-3 mb-10">
            {T.clinic.bullets.map((bullet) => (
              <li class="flex items-center gap-3 text-sm text-slate-700">
                <span class="w-1.5 h-1.5 rounded-full bg-gradient-to-r from-brand-blue to-brand-pink"></span> {bullet}
              </li>
            ))}
          </ul>
          <a href="/mr/about/" class="inline-flex items-center gap-2 rounded-full border-2 border-brand-navy text-brand-navy px-7 py-3 text-sm font-semibold transition-all duration-300 hover:bg-brand-navy hover:text-white">
            {T.clinic.cta} →
          </a>
        </div>
      </Reveal>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="py-20 lg:py-28 bg-brand-slate text-white relative overflow-hidden">
    <div class="absolute inset-0 opacity-25 pointer-events-none" style="background: radial-gradient(50rem 26rem at 15% 0%, #2563EB66, transparent), radial-gradient(40rem 22rem at 95% 100%, #DB277744, transparent)"></div>
    <div class="relative max-w-7xl mx-auto px-6 lg:px-10">
      <Reveal client:visible>
        <p class="text-xs uppercase tracking-[0.25em] text-pink-300 font-semibold mb-4">{T.testi.overline}</p>
        <h2 class="font-serif text-3xl md:text-4xl lg:text-5xl tracking-tight mb-16">{T.testi.h1} <span class="italic text-pink-200">{T.testi.h2}</span></h2>
      </Reveal>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {TESTIMONIALS.map((t, i) => (
          <Reveal client:visible delay={i * 0.07}>
            <div class="card-lift h-full rounded-3xl bg-white/5 border border-white/10 p-7 backdrop-blur-sm">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-pink-400 mb-5"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"/></svg>
              <p class="text-sm leading-relaxed text-indigo-50/90">{t.text}</p>
              <div class="mt-6 pt-5 border-t border-white/10">
                <p class="text-sm font-semibold">{t.name}</p>
                <p class="text-xs text-pink-300 mt-0.5">{t.concern}</p>
              </div>
            </div>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <!-- Partners -->
  <section class="py-20 lg:py-24 bg-white/50">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <Reveal client:visible>
        <p class="text-xs uppercase tracking-[0.25em] text-brand-blue font-semibold mb-4">{T.partners.overline}</p>
        <h2 class="font-serif text-3xl md:text-4xl tracking-tight text-brand-dark">{T.partners.h1} <span class="text-magic italic">{T.partners.h2}</span></h2>
        <p class="text-sm text-slate-500 mt-4 max-w-lg mb-14">{T.partners.sub}</p>
      </Reveal>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {PARTNERS.map((p, i) => (
          <Reveal client:visible delay={i * 0.05}>
            <a href={p.url} target="_blank" rel="noopener noreferrer sponsored" class="card-lift glass-deep rounded-2xl p-6 h-full block group">
              <div class="flex items-center justify-between mb-3">
                <h3 class="font-serif text-lg text-brand-dark group-hover:text-brand-navy transition-colors">{p.name}</h3>
                <span class="text-[10px] uppercase tracking-widest font-bold text-brand-pink bg-pink-50 rounded-full px-3 py-1">{p.type}</span>
              </div>
              <p class="text-sm text-slate-600">{p.note}</p>
              <span class="mt-4 inline-flex items-center gap-1.5 text-xs font-semibold text-brand-navy">{T.partners.visit} ↗</span>
            </a>
          </Reveal>
        ))}
      </div>
      <p class="text-[11px] text-slate-400 mt-8">{T.partners.disclosure}</p>
    </div>
  </section>

  <!-- Newsletter CTA -->
  <section class="py-20 lg:py-24 relative overflow-hidden">
    <div class="fluid-bg"></div>
    <Reveal client:visible className="relative max-w-3xl mx-auto px-6 text-left lg:text-center">
      <img src="/images/logo.png" alt="" aria-hidden="true" class="w-12 h-12 lg:mx-auto mb-6" width="48" height="48" />
      <h2 class="font-serif text-3xl md:text-4xl lg:text-5xl tracking-tight text-brand-dark mb-5">{T.news.h1} <span class="text-magic italic">{T.news.h2}</span></h2>
      <p class="text-slate-600 mb-9 lg:max-w-md lg:mx-auto">{T.news.text}</p>
      <div class="lg:max-w-md lg:mx-auto">
        <NewsletterForm client:visible formspreeId={FORMSPREE_ID} />
      </div>
    </Reveal>
  </section>

  <Footer />
  <WhatsApp />
</Base>
