---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import WhatsApp from '../../components/WhatsApp.astro';
import { Reveal, KineticLines } from '../../components/Motion.jsx';
import NewsletterForm from '../../components/NewsletterForm.jsx';
import { BLOG_POSTS } from '../../data/blog.js';
import { BRAND } from '../../data/content.js';
const FORMSPREE_ID = import.meta.env.PUBLIC_FORMSPREE_ID || 'YOUR_FORM_ID';

const [featured, ...rest] = BLOG_POSTS;
---

<Base title="The Essence Journal — Ayurvedic Wisdom for Hair, Skin & Hormones" description="Evidence-aware Ayurvedic articles on hair care, skin health, nails, PCOS, women's health and Panchakarma — by Dr. Aditi Varekar Khatate.">
  <Navbar />

  <main class="pt-32">
    <section class="max-w-7xl mx-auto px-6 lg:px-10 relative">
      <div class="fluid-bg"></div>
      <div class="relative">
        <p class="text-xs uppercase tracking-[0.25em] text-brand-blue font-semibold mb-4">The Essence Journal</p>
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl tracking-tight leading-[1.06] text-brand-dark">
          <KineticLines client:load lines={['Wisdom, written']} />
          <span class="text-magic italic"><KineticLines client:load lines={['by a physician.']} delay={0.15} /></span>
        </h1>
      </div>
    </section>

    <section class="max-w-7xl mx-auto px-6 lg:px-10 mt-16">
      <Reveal client:visible>
        <a href={`/blog/${featured.slug}/`} class="card-lift group grid lg:grid-cols-2 rounded-[2rem] overflow-hidden glass-deep">
          <div class="img-frame">
            <img src={featured.image} alt={featured.title} class="w-full h-full min-h-[280px] object-cover" />
          </div>
          <div class="p-8 lg:p-12 flex flex-col justify-center">
            <div class="flex items-center gap-3 text-xs font-semibold uppercase tracking-widest text-brand-pink mb-5">
              <span class="bg-pink-50 rounded-full px-3 py-1">{featured.category}</span>
              <span class="text-slate-400 normal-case tracking-normal">{featured.readTime}</span>
            </div>
            <h2 class="font-serif text-2xl lg:text-3xl tracking-tight text-brand-dark group-hover:text-brand-navy transition-colors">{featured.title}</h2>
            <p class="text-slate-600 text-sm leading-relaxed mt-4">{featured.excerpt}</p>
            <span class="mt-7 inline-flex items-center gap-1 text-sm font-semibold text-brand-navy">Read article ↗</span>
          </div>
        </a>
      </Reveal>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-10">
        {rest.map((p, i) => (
          <Reveal client:visible delay={i * 0.05}>
            <a href={`/blog/${p.slug}/`} class="card-lift group block rounded-3xl overflow-hidden glass-deep h-full">
              <div class="img-frame"><img src={p.image} alt={p.title} loading="lazy" class="w-full aspect-[16/10] object-cover" /></div>
              <div class="p-6">
                <div class="flex items-center gap-2 text-[10px] font-bold uppercase tracking-widest text-brand-pink mb-3">
                  <span class="bg-pink-50 rounded-full px-2.5 py-1">{p.category}</span>
                  <span class="text-slate-400">{p.readTime}</span>
                </div>
                <h3 class="font-serif text-lg leading-snug text-brand-dark group-hover:text-brand-navy transition-colors">{p.title}</h3>
                <p class="text-xs text-slate-500 leading-relaxed mt-3 line-clamp-2">{p.excerpt}</p>
              </div>
            </a>
          </Reveal>
        ))}
      </div>
    </section>

    <section class="max-w-2xl mx-auto px-6 py-20 text-left lg:text-center">
      <Reveal client:visible>
        <h2 class="font-serif text-2xl md:text-3xl tracking-tight text-brand-dark mb-4">Never miss an <span class="text-magic italic">article</span></h2>
        <p class="text-sm text-slate-600 mb-7">Join The Essence Letter — one email a month, physician-written.</p>
        <NewsletterForm client:visible formspreeId={FORMSPREE_ID} />
      </Reveal>
    </section>
  </main>

  <Footer />
  <WhatsApp />
</Base>
