---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsApp from '../components/WhatsApp.astro';
import { Reveal, KineticLines } from '../components/Motion.jsx';
import { BRAND, TIMELINE, CREDENTIALS } from '../data/content.js';
---

<Base title="About Dr. Aditi Varekar Khatate — BAMS, MD (Ayurveda) | Essence by Aditi" description="Gold medalist BAMS MD Ayurveda physician, published researcher, COVID warrior & Ayurvedic cosmetology specialist in Navi Mumbai. Meet Dr. Aditi Varekar Khatate.">
  <Navbar />

  <main class="pt-32">
    <section class="max-w-7xl mx-auto px-6 lg:px-10 relative">
      <div class="fluid-bg"></div>
      <div class="relative grid lg:grid-cols-12 gap-14 items-start">
        <div class="lg:col-span-7">
          <p class="text-xs uppercase tracking-[0.25em] text-brand-blue font-semibold mb-4">The Physician</p>
          <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl tracking-tight leading-[1.06] text-brand-dark">
            <KineticLines client:load lines={['Dr. Aditi', 'Varekar Khatate']} />
          </h1>
          <p class="mt-3 font-serif italic text-lg text-magic">BAMS · MD (Ayurveda) · {BRAND.regNo}</p>
          <div class="mt-8 space-y-5 text-slate-600 leading-relaxed max-w-2xl">
            <p>Aditi's story begins at YMT Ayurvedic Medical College, Navi Mumbai — where she didn't just study Ayurveda, she topped it: merit medals across BAMS, the Himalaya Ayurvishard Award, and eventually 1st rank in her MD (Ayurveda).</p>
            <p>Between degrees, she served where medicine matters most — rural primary health centres, a sub-district hospital, and the COVID frontlines with Navi Mumbai Municipal Corporation. In 2023 she published original research on the antimicrobial activity of Chandramrut Ras in an international journal.</p>
            <p>Today, as Senior Consultant at Urban Ayurveda (Kharghar & Thane), she specialises in trichology, Ayurvedic cosmetology, and Stri Rog (women's health) — and as a Maharashtra-registered practitioner, she is authorized to diagnose using modern medicine, giving her patients genuinely integrative care.</p>
            <p class="font-serif italic text-sm md:text-base text-brand-dark flex items-start gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-pink-400 shrink-0 mt-0.5"><path d="M12 7.5a4.5 4.5 0 1 1 4.5 4.5M12 7.5A4.5 4.5 0 1 0 7.5 12M12 7.5V9m-4.5 3a4.5 4.5 0 0 0 4.5 4.5M7.5 12H9m7.5 0a4.5 4.5 0 0 1-4.5 4.5m0 0V15m0 1.5v-1.5m0 0a4.5 4.5 0 0 1-4.5-4.5"/></svg>
              Trained in the classical Guru–Shishya Parampara — knowledge received from teachers, practised with reverence.
            </p>
            <p class="font-serif italic text-brand-navy text-lg">Essence by Aditi is her next chapter: a brand, a future flagship clinic, and one day, a formulations company — built on the same rigour.</p>
          </div>
          <a href="/contact/" class="sheen mt-10 inline-flex items-center gap-2 rounded-full bg-brand-navy text-white px-7 py-3.5 text-sm font-semibold transition-all duration-300 hover:bg-gradient-to-r hover:from-brand-blue hover:to-brand-pink hover:-translate-y-0.5 hover:shadow-xl hover:shadow-pink-900/20">
            Consult Dr. Aditi →
          </a>
        </div>
        <div class="lg:col-span-5 space-y-5">
          <Reveal client:visible>
            <div class="relative">
              <div class="absolute -inset-3 rounded-[2.3rem] bg-gradient-to-br from-pink-200/50 via-white/0 to-indigo-200/50 blur-sm" aria-hidden="true"></div>
              <div class="img-frame relative rounded-[2rem] shadow-2xl shadow-blue-900/10 -rotate-1">
                <img src="/images/hero-aditi.webp" alt="Dr. Aditi Varekar with award and medal" width="400" height="533" class="w-full aspect-[3/4] object-cover" />
              </div>
            </div>
          </Reveal>
          <Reveal client:visible delay={0.1}>
            <div class="glass rounded-2xl p-6">
              <p class="font-serif text-4xl text-magic">Rank 1</p>
              <p class="text-sm text-slate-600 mt-1">Final year MD (Ayurveda), 2024 — with a published international research paper to her name.</p>
            </div>
          </Reveal>
        </div>
      </div>
    </section>

    <!-- Timeline -->
    <section class="py-20 lg:py-28 bg-white/50">
      <div class="max-w-7xl mx-auto px-6 lg:px-10">
        <Reveal client:visible>
          <p class="text-xs uppercase tracking-[0.25em] text-brand-blue font-semibold mb-4">The Journey</p>
          <h2 class="font-serif text-3xl md:text-4xl lg:text-5xl tracking-tight text-brand-dark mb-16">From gold medals to <span class="text-magic italic">golden standards</span></h2>
        </Reveal>
        <div class="relative border-l-2 border-indigo-100 ml-3 space-y-12">
          {TIMELINE.map((t, i) => (
            <Reveal client:visible delay={i * 0.04}>
              <div class="relative pl-10 group">
                <span class="absolute -left-[9px] top-1.5 w-4 h-4 rounded-full bg-white border-[3px] border-brand-blue transition-colors duration-300 group-hover:border-brand-pink"></span>
                <p class="text-xs uppercase tracking-[0.2em] font-bold text-brand-pink">{t.year}</p>
                <h3 class="font-serif text-xl text-brand-dark mt-2">{t.title}</h3>
                <p class="text-sm text-slate-600 mt-2 max-w-xl leading-relaxed">{t.text}</p>
              </div>
            </Reveal>
          ))}
        </div>
      </div>
    </section>

    <!-- Credentials -->
    <section class="py-20 lg:py-28 relative overflow-hidden">
      <div class="fluid-bg"></div>
      <div class="relative max-w-7xl mx-auto px-6 lg:px-10">
        <Reveal client:visible>
          <p class="text-xs uppercase tracking-[0.25em] text-brand-blue font-semibold mb-4">Credentials</p>
          <h2 class="font-serif text-3xl md:text-4xl tracking-tight text-brand-dark mb-14">Certified. Published. <span class="text-magic italic">Proven.</span></h2>
        </Reveal>
        <div class="grid sm:grid-cols-2 gap-4">
          {CREDENTIALS.map((c, i) => (
            <Reveal client:visible delay={i * 0.04}>
              <div class="card-lift flex items-center gap-4 glass-deep rounded-2xl px-6 py-5">
                <span class:list={['w-10 h-10 shrink-0 rounded-full text-white flex items-center justify-center', i % 2 ? 'bg-gradient-to-br from-brand-pink to-brand-purple' : 'bg-gradient-to-br from-brand-navy to-brand-blue']}>
                  {i % 4 === 0 && <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>}
                  {i % 4 === 1 && <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>}
                  {i % 4 === 2 && <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>}
                  {i % 4 === 3 && <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>}
                </span>
                <p class="text-sm text-slate-700 font-medium">{c}</p>
              </div>
            </Reveal>
          ))}
        </div>
      </div>
    </section>

    <!-- Certificates -->
    <section class="py-20 lg:py-28 bg-white/50">
      <div class="max-w-7xl mx-auto px-6 lg:px-10">
        <Reveal client:visible>
          <p class="text-xs uppercase tracking-[0.25em] text-brand-blue font-semibold mb-4">Certificates & Registrations</p>
          <h2 class="font-serif text-3xl md:text-4xl tracking-tight text-brand-dark mb-14">Verified. <span class="text-magic italic">On record.</span></h2>
        </Reveal>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
          {[
            { src: "/images/cert-bams-merit.webp", label: "BAMS Merit Certificate" },
            { src: "/images/cert-bams-degree.webp", label: "BAMS Degree — MUHS" },
            { src: "/images/cert-mcim.webp", label: "MCIM Registration" },
            { src: "/images/cert-cosmetology.webp", label: "Ayurvedic Cosmetology — KASE" },
            { src: "/images/cert-wjpr.webp", label: "WJPR Publication" },
            { src: "/images/cert-pharmacovigilance.webp", label: "Pharmacovigilance" },
            { src: "/images/cert-ipr.webp", label: "IPR & Research (MUHS)" },
            { src: "/images/cert-dravyagun.webp", label: "Dravyagun Certified" },
            { src: "/images/cert-rognidan.webp", label: "Rognidan Certified" },
            { src: "/images/cert-yoga-day.webp", label: "International Yoga Day" },
          ].map((c, i) => (
            <Reveal client:visible delay={i * 0.04}>
              <div class="card-lift glass-deep rounded-2xl overflow-hidden group">
                <div class="aspect-[3/4] overflow-hidden">
                  <img src={c.src} alt={c.label} loading="lazy" class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-105" />
                </div>
                <p class="text-xs text-slate-600 font-medium px-3 py-2.5 text-center">{c.label}</p>
              </div>
            </Reveal>
          ))}
        </div>
      </div>
    </section>

    <!-- Photo Gallery -->
    <section class="py-20 lg:py-28 bg-white/50">
      <div class="max-w-7xl mx-auto px-6 lg:px-10">
        <Reveal client:visible>
          <p class="text-xs uppercase tracking-[0.25em] text-brand-blue font-semibold mb-4">Gallery</p>
          <h2 class="font-serif text-3xl md:text-4xl tracking-tight text-brand-dark mb-14">Moments from the <span class="text-magic italic">journey</span></h2>
        </Reveal>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
          {[
            { src: "/images/graduation-cap.webp", alt: "Dr. Aditi — graduation day" },
            { src: "/images/ceremony-event.webp", alt: "Dr. Aditi at graduation ceremony" },
            { src: "/images/patient-treatment.webp", alt: "Dr. Aditi treating a patient" },
            { src: "/images/camp-consultation.webp", alt: "Dr. Aditi — free health camp" },
            { src: "/images/clinic-patients.webp", alt: "Patients at Urban Ayurveda clinic" },
            { src: "/images/product-yashti-oil.webp", alt: "Yashti Amlaki Oil by Essence by Aditi" },
            { src: "/images/portrait-desk.webp", alt: "Dr. Aditi at work" },
            { src: "/images/graduation-ceremony.webp", alt: "Dr. Aditi — BAMS convocation" },
          ].map((img, i) => (
            <Reveal client:visible delay={i * 0.03}>
              <div class:list={['card-lift img-frame rounded-2xl', i % 3 === 1 ? 'mt-4' : '']}>
                <img src={img.src} alt={img.alt} loading="lazy" width="300" height="400" class="w-full aspect-[3/4] object-cover" />
              </div>
            </Reveal>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsApp />
</Base>
