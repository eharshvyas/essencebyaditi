---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsApp from '../components/WhatsApp.astro';
import { BRAND, TIMELINE, CREDENTIALS } from '../data/content.js';
---

<Base title="About Dr. Aditi Varekar Khatate — BAMS, MD (Ayurveda) | Essence by Aditi" description="Gold medalist BAMS MD Ayurveda physician, published researcher, COVID warrior & Ayurvedic cosmetology specialist in Navi Mumbai. Meet Dr. Aditi Varekar Khatate.">
  <Navbar />

  <main class="pt-32">
    <section class="max-w-7xl mx-auto px-6 lg:px-10 relative">
      <div class="fluid-bg"></div>
      <div class="relative grid lg:grid-cols-12 gap-14 items-start">
        <div class="lg:col-span-7">
          <p class="text-xs uppercase tracking-[0.25em] text-brand-blue font-semibold mb-4">The Physician</p>
          <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl tracking-tight leading-[1.06] text-brand-dark">
            Dr. Aditi<br />Varekar Khatate
          </h1>
          <p class="mt-3 font-serif italic text-lg text-magic">BAMS · MD (Ayurveda) · {BRAND.regNo}</p>
          <div class="mt-8 space-y-5 text-slate-600 leading-relaxed max-w-2xl">
            <p>Aditi's story begins at YMT Ayurvedic Medical College, Navi Mumbai — where she didn't just study Ayurveda, she topped it: merit medals across BAMS, the Himalaya Ayurvishard Award, and eventually 1st rank in her MD (Ayurveda).</p>
            <p>Between degrees, she served where medicine matters most — rural primary health centres, a sub-district hospital, and the COVID frontlines with Navi Mumbai Municipal Corporation. In 2023 she published original research on the antimicrobial activity of Chandramrut Ras in an international journal.</p>
            <p>Today, as Senior Consultant at Urban Ayurveda (Kharghar & Thane), she specialises in trichology, Ayurvedic cosmetology, and Stri Rog (women's health) — and as a Maharashtra-registered practitioner, she is authorized to diagnose using modern medicine, giving her patients genuinely integrative care.</p>
            <p class="font-serif italic text-brand-navy text-lg">Essence by Aditi is her next chapter: a brand, a future flagship clinic, and one day, a formulations company — built on the same rigour.</p>
          </div>
          <a href="/contact/" class="sheen mt-10 inline-flex items-center gap-2 rounded-full bg-brand-navy text-white px-7 py-3.5 text-sm font-semibold transition-all duration-300 hover:bg-gradient-to-r hover:from-brand-blue hover:to-brand-pink hover:-translate-y-0.5 hover:shadow-xl hover:shadow-pink-900/20">
            Consult Dr. Aditi →
          </a>
        </div>
        <div class="lg:col-span-5 space-y-5">
          <div class="relative">
            <div class="absolute -inset-3 rounded-[2.3rem] bg-gradient-to-br from-pink-200/50 via-white/0 to-indigo-200/50 blur-sm" aria-hidden="true"></div>
            <div class="img-frame relative rounded-[2rem] shadow-2xl shadow-blue-900/10 -rotate-1">
              <img src="/images/portrait-1.webp" alt="Dr. Aditi Varekar at her MD graduation" class="w-full aspect-[3/4] object-cover" />
            </div>
          </div>
          <div class="glass rounded-2xl p-6">
            <p class="font-serif text-4xl text-magic">Rank 1</p>
            <p class="text-sm text-slate-600 mt-1">Final year MD (Ayurveda), 2024 — with a published international research paper to her name.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Timeline -->
    <section class="py-20 lg:py-28 mt-16 bg-white/50">
      <div class="max-w-7xl mx-auto px-6 lg:px-10">
        <p class="text-xs uppercase tracking-[0.25em] text-brand-blue font-semibold mb-4">The Journey</p>
        <h2 class="font-serif text-3xl md:text-4xl lg:text-5xl tracking-tight text-brand-dark mb-16">From gold medals to <span class="text-magic italic">golden standards</span></h2>
        <div class="relative border-l-2 border-indigo-100 ml-3 space-y-12">
          {TIMELINE.map((t) => (
            <div class="relative pl-10 group">
              <span class="absolute -left-[9px] top-1.5 w-4 h-4 rounded-full bg-white border-[3px] border-brand-blue transition-colors duration-300 group-hover:border-brand-pink"></span>
              <p class="text-xs uppercase tracking-[0.2em] font-bold text-brand-pink">{t.year}</p>
              <h3 class="font-serif text-xl text-brand-dark mt-2">{t.title}</h3>
              <p class="text-sm text-slate-600 mt-2 max-w-xl leading-relaxed">{t.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Credentials -->
    <section class="py-20 lg:py-24 relative overflow-hidden">
      <div class="fluid-bg"></div>
      <div class="relative max-w-7xl mx-auto px-6 lg:px-10">
        <p class="text-xs uppercase tracking-[0.25em] text-brand-blue font-semibold mb-4">Credentials</p>
        <h2 class="font-serif text-3xl md:text-4xl tracking-tight text-brand-dark mb-14">Certified. Published. <span class="text-magic italic">Proven.</span></h2>
        <div class="grid sm:grid-cols-2 gap-4">
          {CREDENTIALS.map((c, i) => (
            <div class="card-lift flex items-center gap-4 glass-deep rounded-2xl px-6 py-5">
              <span class:list={['w-10 h-10 shrink-0 rounded-full text-white flex items-center justify-center', i % 2 ? 'bg-gradient-to-br from-brand-pink to-brand-purple' : 'bg-gradient-to-br from-brand-navy to-brand-blue']}>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
              </span>
              <p class="text-sm text-slate-700 font-medium">{c}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Photo grid -->
    <section class="pb-8 max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {["/images/event-1.webp", "/images/clinic-6.webp", "/images/portrait-2.webp", "/images/studio-1.webp"].map((src, i) => (
          <div class:list={['img-frame rounded-2xl', i % 2 ? 'mt-6' : '']}>
            <img src={src} alt="Dr. Aditi — clinic and milestones" loading="lazy" class="w-full aspect-[3/4] object-cover" />
          </div>
        ))}
      </div>
    </section>
  </main>

  <Footer />
  <WhatsApp />
</Base>
