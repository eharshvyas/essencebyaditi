---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsApp from '../components/WhatsApp.astro';
import { SERVICES, MANIFESTO, TESTIMONIALS, PARTNERS, MARQUEE_ITEMS, ELEMENTS, BRAND } from '../data/content.js';
---

<Base title="Essence by Aditi — Dr. Aditi Varekar Khatate | Ayurvedic Doctor Navi Mumbai" description="Root-cause Ayurvedic care for hair, skin, nails & women's health by Dr. Aditi Varekar Khatate (BAMS, MD Ayurveda), Navi Mumbai. Book a consultation.">
  <Navbar />

  <!-- Hero -->
  <section class="relative min-h-screen flex items-center overflow-hidden pt-32 pb-16">
    <div class="fluid-bg"></div>
    <div class="relative max-w-7xl mx-auto px-6 lg:px-10 grid lg:grid-cols-12 gap-12 items-center w-full">
      <div class="lg:col-span-7">
        <span class="inline-flex items-center gap-2 glass rounded-full px-4 py-2 text-xs font-medium text-brand-navy mb-8">
          BAMS · MD (Ayurveda) · Gold Medalist · Navi Mumbai
        </span>
        <h1 class="font-serif text-5xl sm:text-6xl lg:text-7xl font-medium tracking-tight leading-[1.04] text-brand-dark">
          Your essence,<br />restored by<br /><span class="text-magic italic">Ayurveda.</span>
        </h1>
        <p class="mt-8 text-base md:text-lg text-slate-600 max-w-xl leading-relaxed">
          Root-cause care for <strong class="text-slate-800 font-semibold">hair, skin, nails & women's health</strong> — by Dr. Aditi Varekar Khatate, a published researcher blending classical Ayurveda with modern diagnostics.
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a href="/contact/" class="sheen group inline-flex items-center gap-2 rounded-full bg-brand-navy text-white px-7 py-3.5 text-sm font-semibold transition-all duration-300 hover:bg-gradient-to-r hover:from-brand-blue hover:to-brand-pink hover:shadow-xl hover:shadow-pink-900/20 hover:-translate-y-0.5">
            Book a Consultation <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a href="/services/" class="link-underline text-sm font-semibold text-brand-navy">Explore treatments</a>
        </div>
        <div class="mt-14 flex gap-10">
          <div><p class="font-serif text-3xl text-brand-navy">7+</p><p class="text-xs text-slate-500 mt-1 tracking-wide">Years in medicine</p></div>
          <div><p class="font-serif text-3xl text-brand-navy">4</p><p class="text-xs text-slate-500 mt-1 tracking-wide">Merit medals</p></div>
          <div><p class="font-serif text-3xl text-brand-navy">1000s</p><p class="text-xs text-slate-500 mt-1 tracking-wide">Patients guided</p></div>
        </div>
      </div>
      <div class="lg:col-span-5 relative">
        <div class="absolute -inset-3 rounded-[2.3rem] bg-gradient-to-br from-indigo-200/50 via-white/0 to-pink-200/50 blur-sm" aria-hidden="true"></div>
        <div class="img-frame relative rounded-[2rem] rotate-1 shadow-2xl shadow-blue-900/15">
          <img src="/images/portrait-4.webp" alt="Dr. Aditi Varekar Khatate at her clinic" class="w-full aspect-[4/5] object-cover" width="500" height="625" />
        </div>
        <div class="absolute -bottom-6 -left-6 glass rounded-2xl px-5 py-4 max-w-[240px]">
          <p class="font-serif italic text-sm text-brand-navy">"We treat the root. Radiance follows."</p>
          <p class="text-[11px] text-slate-500 mt-2">— Dr. Aditi Varekar Khatate</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Marquee -->
  <div class="border-y border-indigo-100 bg-white/60 py-5 overflow-hidden">
    <div class="flex animate-[scroll_30s_linear_infinite] whitespace-nowrap">
      {[...MARQUEE_ITEMS, ...MARQUEE_ITEMS].map((item) => (
        <span class="marquee-text text-lg md:text-xl text-brand-navy/80 mx-8 flex items-center gap-8 shrink-0">{item} ✦</span>
      ))}
    </div>
  </div>

  <!-- Elements -->
  <section class="py-20 lg:py-24 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <p class="text-xs uppercase tracking-[0.25em] text-brand-blue font-semibold mb-4">Panchamahabhuta Siddhanta</p>
      <h2 class="font-serif text-3xl md:text-4xl tracking-tight text-brand-dark">Built on the <span class="text-magic italic">five elements</span></h2>
      <p class="text-sm text-slate-500 mt-4 max-w-lg">Ayurveda sees you as a living balance of five great elements. Every Essence protocol works to restore that original balance.</p>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 mt-12">
        {ELEMENTS.map((el, i) => (
          <div class="card-lift glass-deep rounded-3xl p-6 text-center h-full group">
            <span class:list={['mx-auto w-12 h-12 rounded-2xl flex items-center justify-center text-white mb-4 transition-transform duration-500 group-hover:scale-110 group-hover:rotate-6', i % 2 ? 'bg-gradient-to-br from-brand-pink to-brand-purple' : 'bg-gradient-to-br from-brand-navy to-brand-blue']}>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/></svg>
            </span>
            <h3 class="font-serif text-lg text-brand-dark">{el.name}</h3>
            <p class="text-[11px] text-slate-500 mt-1.5 leading-relaxed">{el.sub}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Manifesto -->
  <section class="relative py-20 lg:py-28 overflow-hidden">
    <div class="fluid-bg"></div>
    <div class="relative max-w-7xl mx-auto px-6 lg:px-10">
      <p class="text-xs uppercase tracking-[0.25em] text-brand-blue font-semibold mb-4">The Essence Philosophy</p>
      <h2 class="font-serif text-3xl md:text-4xl lg:text-5xl tracking-tight text-brand-dark max-w-2xl leading-tight">
        Simple on the surface.<br /><span class="text-magic italic">Profound at the root.</span>
      </h2>
      <div class="mt-14 grid md:grid-cols-2 gap-x-16 gap-y-14">
        {MANIFESTO.map((m) => (
          <div class="flex gap-8 group">
            <span class="font-serif text-6xl lg:text-7xl font-light text-indigo-200 leading-none transition-colors duration-500 group-hover:text-pink-300 select-none">{m.num}</span>
            <div class="pt-2">
              <h3 class="font-serif text-xl md:text-2xl text-brand-navy mb-3">{m.title}</h3>
              <p class="text-sm md:text-base text-slate-600 leading-relaxed max-w-md">{m.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="py-20 lg:py-28 bg-white/50 relative">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="flex flex-wrap items-end justify-between gap-6 mb-16">
        <div>
          <p class="text-xs uppercase tracking-[0.25em] text-brand-blue font-semibold mb-4">Treatments</p>
          <h2 class="font-serif text-3xl md:text-4xl lg:text-5xl tracking-tight text-brand-dark">Where science meets <span class="text-magic italic">shastra</span></h2>
        </div>
        <a href="/services/" class="link-underline text-sm font-semibold text-brand-navy inline-flex items-center gap-1">All services ↗</a>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {SERVICES.slice(0, 6).map((s, i) => (
          <a href="/services/" class:list={['card-lift group block rounded-3xl p-8 border h-full', i === 0 || i === 3 ? 'bg-gradient-to-br from-brand-navy to-[#3B2A8A] border-transparent text-white' : 'glass-deep border-indigo-100']}>
            <span class:list={['font-serif text-4xl font-light', i === 0 || i === 3 ? 'text-pink-300' : 'text-indigo-200 group-hover:text-pink-300 transition-colors duration-500']}>{s.num}</span>
            <h3 class:list={['font-serif text-xl mt-6 mb-3', i === 0 || i === 3 ? 'text-white' : 'text-brand-dark']}>{s.title}</h3>
            <p class:list={['text-sm leading-relaxed', i === 0 || i === 3 ? 'text-indigo-100/80' : 'text-slate-600']}>{s.short}</p>
            <span class:list={['mt-6 inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-widest', i === 0 || i === 3 ? 'text-pink-200' : 'text-brand-pink']}>Learn more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Clinic -->
  <section class="py-20 lg:py-28 relative overflow-hidden">
    <div class="fluid-bg"></div>
    <div class="relative max-w-7xl mx-auto px-6 lg:px-10 grid lg:grid-cols-2 gap-14 items-center">
      <div class="grid grid-cols-2 gap-4">
        <div class="img-frame rounded-3xl mt-8"><img src="/images/clinic-1.webp" alt="Dr. Aditi consulting a patient" loading="lazy" class="w-full aspect-[3/4] object-cover" /></div>
        <div class="img-frame rounded-3xl"><img src="/images/clinic-4.webp" alt="Trichoscopy hair diagnosis session" loading="lazy" class="w-full aspect-[3/4] object-cover" /></div>
      </div>
      <div>
        <p class="text-xs uppercase tracking-[0.25em] text-brand-blue font-semibold mb-4">In Clinic</p>
        <h2 class="font-serif text-3xl md:text-4xl lg:text-5xl tracking-tight text-brand-dark leading-tight mb-6">
          Diagnosis you can <span class="text-magic italic">see</span>, care you can feel
        </h2>
        <p class="text-slate-600 leading-relaxed mb-6">From trichoscopy-guided scalp analysis to Nadi Pariksha and lab-report reviews — every consultation at Essence is unhurried, evidence-aware and deeply personal. Currently consulting at Urban Ayurveda, Kharghar & Thane.</p>
        <ul class="space-y-3 mb-10">
          {["40–60 minute detailed first consultations", "Modern diagnostics + classical assessment", "Personalised diet, lifestyle & medicine plans", "Online video consultations available"].map((t) => (
            <li class="flex items-center gap-3 text-sm text-slate-700">
              <span class="w-1.5 h-1.5 rounded-full bg-gradient-to-r from-brand-blue to-brand-pink"></span> {t}
            </li>
          ))}
        </ul>
        <a href="/about/" class="inline-flex items-center gap-2 rounded-full border-2 border-brand-navy text-brand-navy px-7 py-3 text-sm font-semibold transition-all duration-300 hover:bg-brand-navy hover:text-white">
          Meet Dr. Aditi →
        </a>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="py-20 lg:py-28 bg-brand-slate text-white relative overflow-hidden">
    <div class="absolute inset-0 opacity-25 pointer-events-none" style="background: radial-gradient(50rem 26rem at 15% 0%, #2563EB66, transparent), radial-gradient(40rem 22rem at 95% 100%, #DB277744, transparent)"></div>
    <div class="relative max-w-7xl mx-auto px-6 lg:px-10">
      <p class="text-xs uppercase tracking-[0.25em] text-pink-300 font-semibold mb-4">Patient Stories</p>
      <h2 class="font-serif text-3xl md:text-4xl lg:text-5xl tracking-tight mb-16">Healing, in their <span class="italic text-pink-200">own words</span></h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {TESTIMONIALS.map((t) => (
          <div class="card-lift h-full rounded-3xl bg-white/5 border border-white/10 p-7 backdrop-blur-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-pink-400 mb-5"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"/></svg>
            <p class="text-sm leading-relaxed text-indigo-50/90">{t.text}</p>
            <div class="mt-6 pt-5 border-t border-white/10">
              <p class="text-sm font-semibold">{t.name}</p>
              <p class="text-xs text-pink-300 mt-0.5">{t.concern}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Partners -->
  <section class="py-20 lg:py-24 bg-white/50">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <p class="text-xs uppercase tracking-[0.25em] text-brand-blue font-semibold mb-4">Trusted Circle</p>
      <h2 class="font-serif text-3xl md:text-4xl tracking-tight text-brand-dark">Partners & curated <span class="text-magic italic">brands</span></h2>
      <p class="text-sm text-slate-500 mt-4 max-w-lg mb-14">Clinics we practice with, and Ayurvedic brands we trust enough to recommend.</p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {PARTNERS.map((p) => (
          <a href={p.url} target="_blank" rel="noopener noreferrer sponsored" class="card-lift glass-deep rounded-2xl p-6 h-full block group">
            <div class="flex items-center justify-between mb-3">
              <h3 class="font-serif text-lg text-brand-dark group-hover:text-brand-navy transition-colors">{p.name}</h3>
              <span class="text-[10px] uppercase tracking-widest font-bold text-brand-pink bg-pink-50 rounded-full px-3 py-1">{p.type}</span>
            </div>
            <p class="text-sm text-slate-600">{p.note}</p>
            <span class="mt-4 inline-flex items-center gap-1.5 text-xs font-semibold text-brand-navy">Visit brand ↗</span>
          </a>
        ))}
      </div>
      <p class="text-[11px] text-slate-400 mt-8">Some links above are affiliate links — purchases support the clinic at no extra cost to you.</p>
    </div>
  </section>

  <!-- Newsletter CTA -->
  <section class="py-20 lg:py-24 relative overflow-hidden">
    <div class="fluid-bg"></div>
    <div class="relative max-w-3xl mx-auto px-6 text-left lg:text-center">
      <img src="/images/logo.png" alt="" aria-hidden="true" class="w-12 h-12 lg:mx-auto mb-6" width="48" height="48" />
      <h2 class="font-serif text-3xl md:text-4xl lg:text-5xl tracking-tight text-brand-dark mb-5">The Essence <span class="text-magic italic">Letter</span></h2>
      <p class="text-slate-600 mb-9 lg:max-w-md lg:mx-auto">One thoughtful email a month — seasonal Ayurvedic rituals, hair & skin wisdom, and women's health science. Free, forever.</p>
      <a href={`mailto:${BRAND.email}?subject=Subscribe to The Essence Letter&body=Hi Dr. Aditi, I'd like to subscribe to The Essence Letter.`} class="sheen inline-flex items-center gap-2 rounded-full bg-brand-navy text-white px-7 py-3.5 text-sm font-semibold transition-all duration-300 hover:bg-brand-blue hover:-translate-y-0.5 hover:shadow-xl">
        Subscribe via email →
      </a>
    </div>
  </section>

  <Footer />
  <WhatsApp />
</Base>

<style>
  @keyframes scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
</style>
