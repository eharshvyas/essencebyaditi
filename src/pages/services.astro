---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsApp from '../components/WhatsApp.astro';
import { Reveal, KineticLines } from '../components/Motion.jsx';
import { SERVICES, FAQS } from '../data/content.js';
---

<Base title="Ayurvedic Treatments — Hair, Skin, Nails, PCOS, Panchakarma | Essence by Aditi" description="Trichology, Ayurvedic cosmetology, nail health, women's health (PCOS), Panchakarma & integrative consultations in Navi Mumbai by Dr. Aditi Varekar Khatate.">
  <Navbar />

  <main class="pt-32">
    <section class="max-w-7xl mx-auto px-6 lg:px-10 relative">
      <div class="fluid-bg"></div>
      <div class="relative">
        <p class="text-xs uppercase tracking-[0.25em] text-brand-blue font-semibold mb-4">Treatments & Care</p>
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl tracking-tight leading-[1.06] text-brand-dark max-w-3xl">
          <KineticLines client:load lines={['Six doors to', 'one destination:']} />
          <KineticLines client:load lines={["balance."]} delay={0.3} spanClassName="text-magic italic" />
        </h1>
        <p class="mt-6 text-slate-600 max-w-xl leading-relaxed">Every protocol is individualised after a detailed consultation — your constitution (Prakriti), your imbalance (Vikriti), your reports, your life.</p>
      </div>
    </section>

    <section class="max-w-7xl mx-auto px-6 lg:px-10 mt-16 space-y-20">
      {SERVICES.map((s, i) => (
        <Reveal client:visible>
          <div class:list={['grid lg:grid-cols-2 gap-10 lg:gap-16 items-center', i % 2 ? 'lg:[direction:rtl]' : '']}>
            <div class="[direction:ltr]">
              <span class="font-serif text-6xl font-light text-indigo-200 select-none">{s.num}</span>
              <h2 class="font-serif text-2xl md:text-3xl text-brand-dark mt-4 mb-4 tracking-tight">{s.title}</h2>
              <p class="text-slate-600 leading-relaxed mb-7">{s.long}</p>
              <ul class="grid sm:grid-cols-2 gap-3 mb-8">
                {s.points.map((p) => (
                  <li class="flex items-center gap-2.5 text-sm text-slate-700">
                    <span class="w-5 h-5 rounded-full bg-pink-50 text-brand-pink flex items-center justify-center shrink-0">
                      <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                    </span>
                    {p}
                  </li>
                ))}
              </ul>
              <a href="/contact/" class="group inline-flex items-center gap-2 text-sm font-semibold text-brand-navy link-underline">
                Book this consultation <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </a>
            </div>
            <div class="[direction:ltr] relative">
              <div class:list={['absolute -inset-2.5 rounded-[2.2rem] blur-sm', i % 2 ? 'bg-gradient-to-br from-pink-200/40 to-indigo-200/40' : 'bg-gradient-to-br from-indigo-200/40 to-pink-200/40']} aria-hidden="true"></div>
              <div class="img-frame relative rounded-[2rem] shadow-xl shadow-blue-900/10">
                <img src={s.image} alt={s.title} loading="lazy" class="w-full aspect-[4/3] object-cover" />
              </div>
            </div>
          </div>
        </Reveal>
      ))}
    </section>

    <!-- FAQs -->
    <section class="max-w-3xl mx-auto px-6 lg:px-10 py-20 lg:py-28">
      <Reveal client:visible>
        <p class="text-xs uppercase tracking-[0.25em] text-brand-blue font-semibold mb-4">Good to Know</p>
        <h2 class="font-serif text-3xl md:text-4xl tracking-tight text-brand-dark mb-10">Questions, <span class="text-magic italic">answered</span></h2>
        <div class="space-y-4">
          {FAQS.map((f) => (
            <details class="group glass-deep rounded-2xl overflow-hidden">
              <summary class="cursor-pointer px-6 py-5 text-left font-medium text-slate-800 hover:text-brand-navy flex items-center justify-between gap-4">
                {f.q}
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 transition-transform group-open:rotate-180"><path d="m6 9 6 6 6-6"/></svg>
              </summary>
              <div class="px-6 pb-5 text-slate-600 leading-relaxed">{f.a}</div>
            </details>
          ))}
        </div>
      </Reveal>
    </section>
  </main>

  <Footer />
  <WhatsApp />
</Base>
